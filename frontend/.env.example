# Legacy FastAPI backend (unused by the static site)
VITE_API_BASE=http://localhost:8000

# Netlify function env (set these in Netlify → Site settings → Environment
# variables; for local `npx netlify dev`, copy to .env — never commit .env).
# This file holds PLACEHOLDERS ONLY — real keys go in .env (gitignored).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ORDER_FROM="async/await drip <orders@asyncdrip.com>"
ORDER_TO=info@asyncdrip.com
PAY_IBAN=ESxx xxxx xxxx xxxx xxxx xxxx
PAY_BIZUM=+34 600 000 000
PAY_REVOLUT=@yourtag
PAY_NAME="Your Name"
# optional: comma-separated origins allowed to call the order function
# (defaults to https://asyncdrip.com + www; localhost and deploy previews are
# always allowed outside production) and the max orders accepted per day
ORDER_ORIGINS=https://asyncdrip.com,https://www.asyncdrip.com
ORDER_DAILY_CAP=40

# `npm run orders` pulls every stored order into frontend/orders.json
# (gitignored). Site ID: Netlify → Site configuration → General. Token:
# Netlify → User settings → Applications → Personal access tokens.
NETLIFY_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NETLIFY_AUTH_TOKEN=nfp_xxxxxxxxxxxxxxxxxxxxxxxx
